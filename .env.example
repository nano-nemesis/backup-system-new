# ─── Paths ────────────────────────────────────────────────────────────────────
NODES_FILE=/root/opt/backup-system-new/nodes.json
STORAGE_DIR=/root/opt/backup-system-new/storage
LOG_DIR=/root/opt/backup-system-new/logs
WEB_USERS_FILE=/root/opt/backup-system-new/users.json

# ─── Web server ───────────────────────────────────────────────────────────────
WEB_LISTEN=0.0.0.0:1909
WEB_SECRET=ganti-dengan-random-string-panjang-minimal-32-karakter
